# Keep local environment files and credentials out of the image build context.
.env
# Ignore every local environment variant, then re-allow the safe sample below.
.env.*
# This template is shareable; do not put real credentials in it.
!.env.example
# Docker installs dependencies for the container rather than copying host modules.
node_modules
npm-debug.log*
coverage
dist
# Git metadata is not needed to run this service.
.git
