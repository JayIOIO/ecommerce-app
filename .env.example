# Copy this file to .env and enter values for your local MySQL installation.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

# Replace with a private random value; do not commit .env.
JWT_SECRET=replace-with-a-long-random-local-secret

AUTH_PORT=4001
CATALOG_PORT=4002
ORDER_PORT=4003
