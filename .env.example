# Local-development MySQL settings used by npm run dev.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

# Shared application JWT signing key. Replace with a private random value.
JWT_SECRET=replace-with-a-long-random-local-secret

AUTH_PORT=4001
CATALOG_PORT=4002
ORDER_PORT=4003

# Docker Compose settings. These are separate from local-development DB_USER
# and DB_PASSWORD so a local root account is never used by app containers.
COMPOSE_PROJECT_NAME=ecommerce-app
COMPOSE_DB_USER=app_user
COMPOSE_DB_PASSWORD=replace-with-a-private-compose-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-private-mysql-root-password
PROXY_PORT=8080
